/* ==== design tokens ==== */
:root{
  color-scheme:light;
  --safe-top:env(safe-area-inset-top,0px);--safe-left:env(safe-area-inset-left,0px);--safe-right:env(safe-area-inset-right,0px);
  --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --text-caption:11px;--text-secondary:12px;--text-meta:13px;--text-body:14px;--text-title:16px;--text-dialog-title:18px;
  --weight-regular:400;--weight-control:600;--weight-emphasis:700;--weight-brand:800;
  --radius-card:12px;--radius-control:12px;--radius-thumb:8px;--radius-dialog:20px;
  --row-padding:12px;--page-gutter:16px;
  --bg:#fbf7f1;--card:#fff;--elevated:#fff;--label:#211c2b;--label2:#655f6e;--label3:#756e7d;
  --sep:rgba(45,33,54,.12);--accent:#e45e3d;--tint:#b93f25;--tint-hover:#a93620;--tint-ink:#fff;
  --fill:#f0ebe7;--active:#f9ece7;--focus:#5d8ff0;--ok:#248a48;--warn:#b66a00;--err:#c43c35;
  --shadow:0 12px 30px rgba(48,32,42,.055),0 1px 3px rgba(48,32,42,.06);--seg-on:#fff
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  color-scheme:dark;
  --bg:#16101d;--card:#211829;--elevated:#2a2033;--label:#f8f4f7;--label2:#c1b9c6;--label3:#968d9c;
  --sep:rgba(255,235,250,.13);--accent:#ff8061;--tint:#ff967d;--tint-hover:#ffa58f;--tint-ink:#241420;
  --fill:#302637;--active:#35232f;--focus:#87aeff;--ok:#58d17b;--warn:#ffb84d;--err:#ff7169;
  --shadow:0 14px 34px rgba(0,0,0,.2),0 1px 3px rgba(0,0,0,.16);--seg-on:#473951
}}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#16101d;--card:#211829;--elevated:#2a2033;--label:#f8f4f7;--label2:#c1b9c6;--label3:#968d9c;
  --sep:rgba(255,235,250,.13);--accent:#ff8061;--tint:#ff967d;--tint-hover:#ffa58f;--tint-ink:#241420;
  --fill:#302637;--active:#35232f;--focus:#87aeff;--ok:#58d17b;--warn:#ffb84d;--err:#ff7169;
  --shadow:0 14px 34px rgba(0,0,0,.2),0 1px 3px rgba(0,0,0,.16);--seg-on:#473951
}
@media (min-width:700px){:root{--page-gutter:24px}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{background:var(--bg);scroll-behavior:smooth}
body{margin:0;padding-top:var(--safe-top);padding-left:var(--safe-left);padding-right:var(--safe-right);background:var(--bg);color:var(--label);font-family:var(--font);font-size:16px;line-height:1.4;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body::before{content:"";position:fixed;top:0;left:0;right:0;height:var(--safe-top);background:var(--bg);z-index:30;pointer-events:none}
body.embed{--safe-top:0px;--safe-left:0px;--safe-right:0px}
a{color:inherit;text-decoration:none}
button,input{font:inherit}
button{color:inherit;background:none;border:0;padding:0;cursor:pointer}
button:disabled{cursor:default;opacity:.55}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
svg{display:block}
[hidden]{display:none!important}

/* ==== category accents ==== */
.c-koncert{--c:#a93822;--cbg:#fbe8e2;--cbg-dark:#493029;--cfg-dark:#ff9a7f}
.c-divadlo{--c:#70409d;--cbg:#f0e7f8;--cbg-dark:#392d46;--cfg-dark:#d2a8fb}
.c-film{--c:#285da8;--cbg:#e5eefb;--cbg-dark:#27374e;--cfg-dark:#91bcfa}
.c-vystava{--c:#116b62;--cbg:#e1f1ee;--cbg-dark:#243d3b;--cfg-dark:#73d5c9}
.c-deti{--c:#a93264;--cbg:#f9e6ee;--cbg-dark:#462b38;--cfg-dark:#fb9ec5}
.c-trh{--c:#536d1d;--cbg:#edf2df;--cbg-dark:#354027;--cfg-dark:#bddd73}
.c-sport{--c:#176b3e;--cbg:#e1f1e8;--cbg-dark:#273d32;--cfg-dark:#7bdaa3}
.c-prednaska{--c:#404c9b;--cbg:#e9ebf8;--cbg-dark:#303346;--cfg-dark:#aeb7ff}
.c-slavnost{--c:#795100;--cbg:#f8efda;--cbg-dark:#433824;--cfg-dark:#f2cb6d}
.c-komunita{--c:#744618;--cbg:#f4e9df;--cbg-dark:#403126;--cfg-dark:#e5b17f}
.c-jine{--c:#5f5967;--cbg:#eeecef;--cbg-dark:#38333d;--cfg-dark:#c8c1cd}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pill{background:var(--cbg-dark,var(--fill));color:var(--cfg-dark,var(--label2))}}
:root[data-theme="dark"] .pill{background:var(--cbg-dark,var(--fill));color:var(--cfg-dark,var(--label2))}

/* ==== shared controls ==== */
.icon{width:20px;height:20px;flex:0 0 auto}
.chip{min-height:44px;border:1px solid var(--sep);border-radius:999px;padding:0 12px;font-size:var(--text-body);font-weight:var(--weight-control);display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--card);color:var(--label2);white-space:nowrap;box-shadow:0 1px 1px rgba(40,25,35,.02)}
.chip:hover{border-color:rgba(228,94,61,.38);color:var(--label)}
.chip:active{transform:scale(.98)}
.chip.on{background:var(--active);border-color:rgba(228,94,61,.42);color:var(--tint)}
.chip .n{font-size:var(--text-secondary);font-variant-numeric:tabular-nums;color:var(--label3)}
.chip.on .n{color:currentColor;opacity:.72}
.chip .icon{width:18px;height:18px}
.chip-remove{gap:6px;padding-right:11px}
.chip-remove .x{font-size:18px;font-weight:400;line-height:1}
.seg{display:flex;background:var(--fill);border:1px solid var(--sep);border-radius:var(--radius-control);padding:3px}
.seg-btn{min-height:44px;border-radius:var(--radius-thumb);padding:0 12px;font-size:var(--text-body);font-weight:var(--weight-control);color:var(--label2);display:flex;align-items:center;justify-content:center;gap:8px}
.seg-btn.on{background:var(--seg-on);color:var(--label);box-shadow:0 1px 4px rgba(40,25,35,.12)}
.seg-btn .icon{width:18px;height:18px}

/* ==== shared cards and rows ==== */
.grp{font-size:var(--text-secondary);text-transform:uppercase;color:var(--label2);margin:20px 0 8px;padding:0;letter-spacing:.055em;font-weight:var(--weight-emphasis)}
.grp:first-child{margin-top:12px}
.grp .n,.grp .aliases{text-transform:none;font-weight:var(--weight-regular);letter-spacing:0}
.grp .aliases{display:block;color:var(--label3);margin-top:2px}
.grp-title{display:flex;align-items:center;gap:8px}
.grp-title .icon{width:17px;height:17px;color:var(--c,var(--label2))}
.list-card{background:var(--card);border:1px solid var(--sep);border-radius:var(--radius-card);overflow:hidden;box-shadow:var(--shadow)}
.row{position:relative;display:flex;align-items:center;gap:12px;min-height:76px;padding:var(--row-padding)}
.row:not(:first-child)::after,.row-separator::after{content:"";position:absolute;left:12px;right:0;top:0;height:1px;background:var(--sep)}
a.row:hover{background:var(--active)}
a.row:active,.row.tap:active{background:var(--active)}
.content{flex:1;min-width:0}
.title{font-size:var(--text-title);font-weight:var(--weight-emphasis);line-height:1.25;letter-spacing:-.01em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.meta{font-size:var(--text-meta);font-weight:var(--weight-regular);line-height:1.4;color:var(--label2);display:flex;align-items:center;gap:8px;margin-top:4px;min-width:0}
.where{display:flex;align-items:center;gap:5px;min-width:0;overflow:hidden}
.where .icon{width:15px;height:15px;color:var(--label3)}
.where-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pill{flex:0 0 auto;font-size:var(--text-caption);font-weight:var(--weight-control);letter-spacing:.015em;border-radius:999px;padding:3px 8px;background:var(--cbg,var(--fill));color:var(--c,var(--label2))}
.pill-neutral{background:var(--fill);color:var(--label2)}
.subline{font-size:12px;color:var(--label3);margin-top:4px}
.status-pill{flex:0 0 auto;font-size:var(--text-secondary);font-weight:var(--weight-control);border-radius:999px;padding:4px 8px;white-space:nowrap}
.status-pill.s-ok{background:rgba(36,138,72,.13);color:var(--ok)}
.status-pill.s-fallback{background:rgba(182,106,0,.13);color:var(--warn)}
.status-pill.s-error{background:rgba(196,60,53,.13);color:var(--err)}
.status-pill.s-disabled{background:var(--fill);color:var(--label3)}
.none-row{color:var(--label2);font-size:14px}
.chev{width:18px;height:18px;color:var(--label3);flex:0 0 auto}

/* ==== dialog list rows ==== */
.list-row{position:relative;display:flex;align-items:center;gap:10px;width:100%;min-height:50px;padding:0 16px;text-align:left;font-size:16px;color:var(--label)}
.list-row:not(:first-child)::before{content:"";position:absolute;left:16px;right:0;top:0;height:1px;background:var(--sep)}
.list-row:hover,.list-row:active{background:var(--active)}
.list-row .lr-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.list-row .lr-count{font-size:14px;color:var(--label3);font-variant-numeric:tabular-nums}
.list-row .lr-check{width:22px;height:22px;flex:0 0 auto;color:var(--tint)}
.list-row .lr-check svg{width:100%;height:100%}

/* ==== utility states ==== */
.empty{text-align:center;padding:58px 24px;color:var(--label2)}
.empty svg{width:46px;height:46px;color:var(--label3);margin:0 auto 14px}
.empty-title{font-size:18px;font-weight:700;color:var(--label)}
.empty-sub{font-size:14px;margin-top:5px}
.disclaimer{font-size:12px;color:var(--label3);margin:12px 4px 0}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
