  document.getElementById('resultCount').textContent=akceLabel(favorites?favoriteEvents.length:count);document.getElementById('rangeLabel').textContent=rangeLabel();document.querySelector('.result-summary').classList.toggle('custom-date',st.tab==='date');document.getElementById('favoritesNote').hidden=!favorites;
