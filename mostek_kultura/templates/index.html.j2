  return h.toString();
}
function canonicalize(){const hash=stateHash();if(location.hash.slice(1)!==hash)history.replaceState(null,'','#'+hash)}
let pendingFocus='';
function focusKey(el){if(!el||el===document.body)return '';const parent=el.closest('[id]');if(el.dataset.tab)return `#${parent.id} [data-tab="${el.dataset.tab}"]`;if(el.dataset.view)return `#viewToggle [data-view="${el.dataset.view}"]`;if(el.dataset.cat)return `#categories [data-cat="${el.dataset.cat}"]`;if(el.hasAttribute('data-clear-cats'))return '#categories [data-clear-cats]';if(el.id==='searchClear'||el.hasAttribute('data-clear-q'))return '#search';if(el.matches('[data-remove-place],[data-reset]'))return '#sourcesBtn';return ''}
