  document.getElementById('tabbar').innerHTML=`<div class="date-tabs">${dateTabs}</div><button type="button" data-tab="favorites" class="favorite-tab${st.tab==='favorites'?' on':''}" aria-pressed="${st.tab==='favorites'}" aria-label="${favoriteLabel}">${ICON.favorite}<span class="tab-label">Oblíbené</span></button>`;
