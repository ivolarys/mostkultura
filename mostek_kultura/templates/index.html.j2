<body>
<div class="wrap">
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-identity">
        <img class="brand-logo" src="logo.svg?v=mostkultura-1" alt="">
        <h1 class="brand"><span>Mostkultura</span></h1>
        <span class="hero-locality">Kultura okolo Mostku</span>
      </div>
      <div class="hero-meta"><div class="hero-update">Aktualizováno <span id="gen"></span> · <span id="total"></span></div></div>
    </div>
  </header>

  <aside class="install-offer" id="installOffer" aria-labelledby="installOfferTitle" hidden>
    <img class="install-offer-icon" src="icon-192.png?v=mostkultura-1" width="48" height="48" alt="" aria-hidden="true">
    <div class="install-offer-copy">
      <h2 class="install-offer-title" id="installOfferTitle" tabindex="-1">Mostkultura na dosah</h2>
      <p class="install-offer-text">Přidejte si ji na plochu a příště otevřete jedním klepnutím.</p>
      <div class="install-actions">
        <button class="install-primary" id="installAction" type="button" aria-controls="installGuide" aria-expanded="false"></button>
        <button class="install-guide-toggle" id="installGuideToggle" type="button" aria-controls="installGuide" aria-expanded="false">Jak na to</button>
      </div>
    </div>
    <button class="install-dismiss" id="installDismiss" type="button" aria-label="Zavřít nabídku"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    <section class="install-guide" id="installGuide" aria-live="polite" hidden></section>
    <p class="install-error" id="installError" role="status" hidden></p>
  </aside>

  <section class="filters" aria-label="Vyhledávání a kategorie">
    <div class="search-row">
      <div class="searchbox">
        <label class="sr-only" for="search">Hledat akci nebo místo</label>
        <span id="searchIcon" aria-hidden="true"></span>
        <input id="search" type="search" inputmode="search" autocomplete="off" placeholder="Hledat akci nebo místo…">
        <button class="search-clear" id="searchClear" type="button" aria-label="Vymazat hledání" hidden></button>
      </div>
      <a class="sources-btn" id="sourcesBtn" data-source-settings href="zdroje.html" aria-label="Vybrat zdroje, města a místa" title="Vybrat zdroje, města a místa"><span id="sourcesBtnIcon" aria-hidden="true"></span><span id="sourceHealthBadge" class="source-health-badge" aria-hidden="true" hidden></span></a>
    </div>
    <div class="category-row" id="categories" aria-label="Kategorie akcí"></div>
    <div class="active-row" id="activeFilters" aria-label="Aktivní filtry" hidden></div>
  </section>

  <div class="period-desktop seg" id="periodDesktop" aria-label="Období"></div>
  <div class="list-head">
    <div class="result-summary"><div class="range-label" id="rangeLabel"></div><div class="result-count" id="resultCount" aria-live="polite"></div></div>
    <div class="view-toggle seg" id="viewToggle" aria-label="Zobrazení"></div>
  </div>
  <p class="favorites-note" id="favoritesNote" hidden>Uložené v tomto prohlížeči.</p>
  <main id="list" class="content-list"></main>
  <aside class="place-search-panel" id="placeSearchPanel" aria-live="polite" hidden></aside>
  <div class="map-wrap" id="mapWrap">
    <div id="map" aria-label="Mapa filtrovaných akcí"></div>
    <div class="map-message" id="mapMessage" hidden><p>Mapu se nepodařilo načíst.</p><button class="map-retry" id="mapRetry" type="button">Zkusit znovu</button></div>
    <button class="map-nopos" id="mapNopos" type="button" hidden></button>
  </div>

  <footer class="site-footer">
    <p class="disclaimer">Akce stahujeme jednou denně. Čas a místo si před cestou ověřte u pořadatele.</p>
    <button class="install-reopen" id="installReopen" type="button" hidden>Přidat aplikaci</button>
  </footer>
</div>

<nav class="tabbar" id="tabbar" aria-label="Období"></nav>
<div class="sr-only" id="favoriteStatus" role="status" aria-live="polite"></div>
<div class="share-status" id="shareStatus" role="status" aria-live="polite" hidden></div>

<dialog class="sheet event-sheet" id="eventDialog" aria-labelledby="eventTitle">
  <div class="sheet-layout">
    <div class="sheet-grabber" aria-hidden="true"></div>
    <header class="sheet-header"><div class="sheet-title" id="eventTitle"></div><button class="sheet-close" id="eventClose" type="button" aria-label="Zavřít"></button></header>
    <div class="sheet-body" id="eventBody"></div>
  </div>
</dialog>

<dialog class="share-dialog" id="shareDialog" aria-labelledby="shareTitle">
  <h2 id="shareTitle">Odkaz na akci</h2>
  <p>Kopírování se nepodařilo. Označte odkaz a zkopírujte ho ručně.</p>
  <input id="shareUrl" aria-label="Odkaz na akci" type="text" readonly>
  <button id="shareClose" type="button">Zavřít</button>
</dialog>

<dialog class="sheet date-sheet" id="dateDialog" aria-labelledby="dateTitle">
  <div class="sheet-layout">
    <div class="sheet-grabber" aria-hidden="true"></div>
    <header class="sheet-header"><div class="sheet-title" id="dateTitle">Vybrat dny<div class="sheet-subtitle">Táhněte přes dny nebo klepněte na začátek a konec.</div></div><button class="sheet-close" id="dateClose" type="button" aria-label="Zavřít bez použití změn"></button></header>
    <div class="sheet-body"><div class="date-selection" id="dateSelection" aria-live="polite"></div><div class="calendar-head"><button class="calendar-nav" id="calendarPrev" type="button" aria-label="Předchozí měsíc"></button><div class="calendar-title" id="calendarTitle" aria-live="polite"></div><button class="calendar-nav" id="calendarNext" type="button" aria-label="Další měsíc"></button></div><div class="calendar-weekdays" aria-hidden="true"><span>Po</span><span>Út</span><span>St</span><span>Čt</span><span>Pá</span><span>So</span><span>Ne</span></div><div class="calendar-days" id="calendarDays" role="group" aria-label="Kalendář"></div></div>
    <footer class="sheet-footer"><button class="apply-btn" id="dateApply" type="button"></button></footer>
  </div>
</dialog>

