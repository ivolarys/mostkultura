  leafletReady=new Promise((resolve,reject)=>{
    let link=document.getElementById('leafletCss');if(!link){link=document.createElement('link');link.id='leafletCss';link.rel='stylesheet';link.href='leaflet/leaflet.css';document.head.appendChild(link)}
    const script=document.createElement('script');script.id='leafletJs';script.src='leaflet/leaflet.js';script.onload=resolve;script.onerror=()=>{script.remove();leafletReady=null;reject(new Error('Leaflet load failed'))};document.head.appendChild(script);
  });return leafletReady;
}
function initMap(){if(map)return;map=L.map('map',{zoomControl:true}).setView([50.5083,15.6975],10);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; OpenStreetMap'}).addTo(map);markersLayer=L.layerGroup().addTo(map)}
function sizeMap(){const el=document.getElementById('map');if(!el)return;if(window.matchMedia('(min-width:700px)').matches&&!embed){el.style.height='';return}const bar=document.getElementById('tabbar');const bh=!embed&&getComputedStyle(bar).display!=='none'?bar.getBoundingClientRect().height+18:0;el.style.height=Math.max(310,window.innerHeight-el.getBoundingClientRect().top-bh)+'px'}
function renderMarkers(events){
  markersLayer.clearLayers();const groups={},noPos=[];
  events.forEach(e=>{if(e.lat==null||e.lon==null){noPos.push(e);return}const key=Number(e.lat).toFixed(5)+','+Number(e.lon).toFixed(5);if(!groups[key])groups[key]={lat:e.lat,lon:e.lon,geo:e.geo,place:e.place,venue:e.geo==='venue'?e.venue:null,events:[]};groups[key].events.push(e)});
  const bounds=[];Object.values(groups).forEach(g=>{const cc={};g.events.forEach(e=>cc[e.category]=(cc[e.category]||0)+1);const topCat=Object.keys(cc).sort((a,b)=>cc[b]-cc[a])[0]||'jine';const n=g.events.length,size=n>1?36:30,approx=g.geo==='place';const title=(g.geo==='venue'?(g.venue||g.place):g.place)||'Místo';const open=()=>openEventDialog(approx?title+' (přibližně)':title,g.events);const marker=L.marker([g.lat,g.lon],{icon:L.divIcon({html:`<div class="mk c-${esc(topCat)}${approx?' mk-approx':''}" style="width:${size}px;height:${size}px" aria-hidden="true">${n>1?n:''}</div>`,className:'mk-wrap',iconSize:[44,44],iconAnchor:[22,22]}),title:`${title}: ${akceLabel(n)}`,alt:`${title}: ${akceLabel(n)}`,keyboard:true}).addTo(markersLayer);marker.on('click',open);const markerEl=marker.getElement();if(markerEl)markerEl.addEventListener('keydown',ev=>{if(ev.key!=='Enter'&&ev.key!==' ')return;ev.preventDefault();ev.stopPropagation();open()});bounds.push([g.lat,g.lon])});
  const btn=document.getElementById('mapNopos');btn.hidden=!noPos.length;if(noPos.length){btn.textContent=`Bez polohy · ${akceLabel(noPos.length)}`;btn.onclick=()=>openEventDialog('Bez polohy',noPos)}return bounds;
}
function showMap(events,place){
  const request=++mapRequest,msg=document.getElementById('mapMessage'),retry=document.getElementById('mapRetry');
  if(!events.length){if(markersLayer)markersLayer.clearLayers();const noPos=document.getElementById('mapNopos');noPos.hidden=true;noPos.onclick=null;retry.hidden=true;if(place&&['today','tomorrow','weekend'].includes(st.tab)){msg.hidden=true;return}msg.querySelector('p').textContent=st.tab==='all'&&place?`Pro „${place.query}“ nemáme ve vybraných zdrojích a filtrech žádné akce.`:'Pro toto období a vybrané filtry nejsou žádné akce.';msg.hidden=false;return}
  retry.hidden=false;msg.querySelector('p').textContent='Mapu se nepodařilo načíst.';msg.hidden=true;
  loadLeaflet().then(()=>{if(request!==mapRequest||st.view!=='map')return;initMap();sizeMap();map.invalidateSize();const bounds=renderMarkers(events);const key=stateHash();if(bounds.length&&key!==lastMapKey)map.fitBounds(bounds,{padding:[34,34],maxZoom:13});lastMapKey=key}).catch(()=>{if(request===mapRequest&&st.view==='map')msg.hidden=false});
}
function openEventDialog(title,events){const dialog=document.getElementById('eventDialog');if(dialog.open)return;document.getElementById('eventTitle').innerHTML=`${esc(title)}<div class="sheet-subtitle">${akceLabel(events.length)}</div>`;document.getElementById('eventBody').innerHTML=`<div class="list-card">${events.slice().sort((a,b)=>a.start.localeCompare(b.start)).map(e=>eventHtml(e,true)).join('')}</div>`;openDialog(dialog)}
function refreshStarButtons(){
  document.querySelectorAll('[data-favorite-key]').forEach(button=>{
    const event=D.events.find(item=>MostkulturaFavorites.key(item)===button.dataset.favoriteKey);
    if(!event)return;
    const saved=MostkulturaFavorites.has(favoriteKeys,event),action=`${saved?'Odebrat':'Přidat'} ${event.title} ${saved?'z':'do'} oblíbených`;
    button.setAttribute('aria-pressed',String(saved));button.setAttribute('aria-label',action);button.title=action;
  });
}
function toggleFavorite(button){
  const key=button.dataset.favoriteKey,event=D.events.find(item=>MostkulturaFavorites.key(item)===key);
  if(!event)return;
  const wasSaved=MostkulturaFavorites.has(favoriteKeys,event),inDialog=!!button.closest('#eventDialog');
  const previous=[...document.querySelectorAll('#list [data-favorite-key]')],index=previous.findIndex(item=>item===button);
  const nextKey=st.tab==='favorites'&&wasSaved&&index>=0?(previous[index+1]||previous[index-1])?.dataset.favoriteKey:'';
  favoriteKeys=MostkulturaFavorites.toggle(favoriteKeys,event);
  const saved=MostkulturaFavorites.save(favoriteKeys);favoriteSaveFailed=!saved;
  const status=document.getElementById('favoriteStatus');status.textContent=saved?(wasSaved?'Odebráno z oblíbených.':'Přidáno do oblíbených.'):'Výběr se nepodařilo uložit. Platí jen do zavření stránky.';status.classList.toggle('sr-only',saved);status.classList.toggle('favorite-status-error',!saved);
  render();refreshStarButtons();
  if(inDialog){button.focus({preventScroll:true});return}
  const target=[...document.querySelectorAll('#list [data-favorite-key]')].find(item=>item.dataset.favoriteKey===(nextKey||key));
  (target||document.querySelector(`${embed?'#periodDesktop':'#tabbar'} [data-tab="favorites"]`)).focus({preventScroll:true});
}

let shareBusy=false,shareInvoker=null,shareStatusTimer=null;
function copiedShareLink(){
  const status=document.getElementById('shareStatus');
  const eventDialog=document.getElementById('eventDialog');
  (eventDialog.open?eventDialog.querySelector('.sheet-layout'):document.body).appendChild(status);
  status.textContent='Odkaz na akci zkopírován.';status.hidden=false;
  clearTimeout(shareStatusTimer);shareStatusTimer=setTimeout(()=>{status.hidden=true;status.textContent=''},4000);
}
function manualShareLink(url){
  const dialog=document.getElementById('shareDialog'),field=document.getElementById('shareUrl');
  field.value=url;dialog.showModal();field.focus({preventScroll:true});field.select();
}
function restoreShareFocus(){
  const visible=button=>button?.isConnected&&button.getClientRects().length&&getComputedStyle(button).visibility==='visible';
  if(visible(shareInvoker)){shareInvoker.focus({preventScroll:true});return}
  const key=shareInvoker?.dataset.shareKey;
  const eventDialog=document.getElementById('eventDialog');
  const root=eventDialog.open?eventDialog:document.getElementById('list');
  const replacement=[...root.querySelectorAll('[data-share-key]')].find(button=>button.dataset.shareKey===key&&visible(button));
  const favoriteNav=document.querySelector(`${embed?'#periodDesktop':'#tabbar'} [data-tab="favorites"]`);
  (replacement||(eventDialog.open?document.getElementById('eventClose'):favoriteNav)||document.getElementById('search')).focus({preventScroll:true});
}
function shareEvent(button){
  if(shareBusy)return;
  const event=D.events.find(item=>MostkulturaFavorites.key(item)===button.dataset.shareKey);
  if(!event)return;
  shareBusy=true;shareInvoker=button;
  // MostkulturaEventShare.share invokes navigator.share before returning its promise.
  MostkulturaEventShare.share(event,{onCopied:copiedShareLink,onManual:manualShareLink})
    .finally(()=>{shareBusy=false});
}

document.getElementById('searchIcon').innerHTML=ICON.search;document.getElementById('searchClear').innerHTML=ICON.close;document.getElementById('sourcesBtnIcon').innerHTML=ICON.source;document.getElementById('eventClose').innerHTML=ICON.close;document.getElementById('dateClose').innerHTML=ICON.close;document.getElementById('calendarPrev').innerHTML=ICON.prev;document.getElementById('calendarNext').innerHTML=ICON.next;
document.getElementById('shareClose').addEventListener('click',()=>document.getElementById('shareDialog').close());
document.getElementById('shareDialog').addEventListener('close',restoreShareFocus);
document.getElementById('gen').textContent=generatedFormatter.format(new Date(D.generated_at));
document.getElementById('total').textContent=akceLabel(EVENTS.filter(sourceAllowed).length);
updateSourceHealthBadge();
document.getElementById('search').addEventListener('input',e=>update(()=>st.q=e.target.value.trimStart().slice(0,120),true));
document.getElementById('search').addEventListener('change',()=>canonicalize());
document.getElementById('searchClear').addEventListener('click',()=>update(()=>st.q=''));
document.getElementById('eventClose').addEventListener('click',()=>closeDialog(document.getElementById('eventDialog')));
document.getElementById('dateClose').addEventListener('click',cancelDate);
document.getElementById('calendarPrev').addEventListener('click',()=>setCalendarMonth(-1));
document.getElementById('calendarNext').addEventListener('click',()=>setCalendarMonth(1));
document.getElementById('calendarDays').addEventListener('pointerdown',e=>{if(calendarPointer||e.isPrimary===false||e.button!==0)return;const b=e.target.closest('[data-calendar-date]');if(!b)return;const previousKeyboardAnchor=keyboardAnchor;keyboardAnchor=null;const iso=b.dataset.calendarDate,previousStart=draftDate,previousEnd=draftDateEnd;let anchor=iso;if(draftDate!==draftDateEnd&&iso===draftDate)anchor=draftDateEnd;else if(draftDate!==draftDateEnd&&iso===draftDateEnd)anchor=draftDate;calendarPointer={id:e.pointerId,down:iso,anchor,start:previousStart,end:previousEnd,selectingEnd:draftSelectingEnd,keyboardAnchor:previousKeyboardAnchor,dragging:false};document.getElementById('calendarDays').setPointerCapture(e.pointerId)});
document.getElementById('calendarDays').addEventListener('pointermove',e=>{if(calendarPointer?.id!==e.pointerId)return;const iso=calendarDateAtPoint(e.clientX,e.clientY);if(!iso||(!calendarPointer.dragging&&iso===calendarPointer.down))return;calendarPointer.dragging=true;setDraftRange(calendarPointer.anchor,iso);paintCalendarRange()});
function finishCalendarPointer(e,cancel=false){if(calendarPointer?.id!==e.pointerId)return;const days=document.getElementById('calendarDays'),pointer=calendarPointer,wasCancelled=cancel||e.type==='pointercancel';calendarPointer=null;if(wasCancelled){setDraftRange(pointer.start,pointer.end);draftSelectingEnd=pointer.selectingEnd;keyboardAnchor=pointer.keyboardAnchor}else if(!pointer.dragging){selectCalendarDate(pointer.down)}else draftSelectingEnd=false;if(days.hasPointerCapture?.(e.pointerId))days.releasePointerCapture(e.pointerId);paintCalendarRange();suppressCalendarClick=true;setTimeout(()=>{suppressCalendarClick=false},0)}
document.getElementById('calendarDays').addEventListener('pointerup',finishCalendarPointer);
document.getElementById('calendarDays').addEventListener('pointercancel',finishCalendarPointer);
document.getElementById('calendarDays').addEventListener('lostpointercapture',e=>finishCalendarPointer(e,true));
document.getElementById('calendarDays').addEventListener('click',e=>{const b=e.target.closest('[data-calendar-date]');if(!b||suppressCalendarClick)return;selectCalendarDate(b.dataset.calendarDate)});
document.getElementById('calendarDays').addEventListener('keydown',e=>{const b=e.target.closest('[data-calendar-date]');if(!b)return;const steps={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7};if(!(e.key in steps))return;e.preventDefault();const next=addDays(b.dataset.calendarDate,steps[e.key]);if(!next)return;if(e.shiftKey){keyboardAnchor=keyboardAnchor||b.dataset.calendarDate;setDraftRange(keyboardAnchor,next);draftSelectingEnd=false;if(Number(next.slice(0,4))===calendarYear&&Number(next.slice(5,7))-1===calendarMonth){paintCalendarRange();document.querySelector(`[data-calendar-date="${next}"]`)?.focus({preventScroll:true})}else{calendarYear=Number(next.slice(0,4));calendarMonth=Number(next.slice(5,7))-1;renderCalendar(next)}return}keyboardAnchor=null;calendarYear=Number(next.slice(0,4));calendarMonth=Number(next.slice(5,7))-1;renderCalendar(next)});
document.getElementById('dateApply').addEventListener('click',()=>applyDate(draftDate,draftDateEnd));
document.getElementById('mapRetry').addEventListener('click',()=>{const visible=visibleEvents();showMap([...visible.main,...visible.ongoing],placeSearchMatch())});
document.addEventListener('click',e=>{if(!e.target.closest('[data-source-settings]'))return;try{sessionStorage.setItem('mostkultura.sourceReturnHash',location.hash)}catch(_){}});
document.getElementById('dateDialog').addEventListener('cancel',e=>{e.preventDefault();cancelDate()});
document.getElementById('eventDialog').addEventListener('close',()=>{document.body.classList.remove('dialog-open');document.body.appendChild(document.getElementById('shareStatus'))});
[document.getElementById('eventDialog'),document.getElementById('dateDialog')].forEach(d=>d.addEventListener('click',e=>{if(e.target===d){if(d.id==='dateDialog')cancelDate();else closeDialog(d)}}));
[document.getElementById('eventDialog'),document.getElementById('dateDialog')].forEach(d=>d.addEventListener('keydown',e=>{if(e.key!=='Tab')return;const items=[...d.querySelectorAll('button:not([disabled]),a[href],input:not([disabled])')].filter(x=>x.offsetParent!==null);if(!items.length)return;const first=items[0],last=items[items.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}));
document.getElementById('categories').addEventListener('wheel',e=>{
  if(e.ctrlKey||Math.abs(e.deltaY)<=Math.abs(e.deltaX))return;
  const el=e.currentTarget,max=el.scrollWidth-el.clientWidth;
  if(max<=0)return;
  const unit=e.deltaMode===1?16:e.deltaMode===2?el.clientWidth:1;
  const before=el.scrollLeft,next=Math.max(0,Math.min(max,before+e.deltaY*unit));
  el.scrollLeft=next;
  if(el.scrollLeft!==before)e.preventDefault();
},{passive:false});
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b||b.closest('#dateDialog'))return;if(b.hasAttribute('data-share-key'))shareEvent(b);else if(b.hasAttribute('data-favorite-key'))toggleFavorite(b);else if(b.hasAttribute('data-show-all-place'))update(()=>st.tab='all',false,'#search');else if(b.dataset.tab==='date')openDateDialog(b);else if(b.dataset.tab)update(()=>st.tab=b.dataset.tab);else if(b.dataset.view)update(()=>st.view=b.dataset.view);else if(b.dataset.cat)update(()=>st.cat.has(b.dataset.cat)?st.cat.delete(b.dataset.cat):st.cat.add(b.dataset.cat));else if(b.hasAttribute('data-clear-cats'))update(()=>st.cat.clear());else if(b.hasAttribute('data-clear-q'))update(()=>st.q='');else if(b.dataset.removePlace)update(()=>st.place.delete(b.dataset.removePlace));else if(b.hasAttribute('data-reset'))update(()=>{st.cat.clear();st.place.clear();st.q=''})});
window.addEventListener('hashchange',()=>{parseState();canonicalize();render()});
function syncSourcePreferences(){
  sourcePrefs=MostkulturaSources.read();
  sourceAllowed=MostkulturaSources.compile(sourcePrefs);
  const disabledPlaces=disabledPlaceSet();
  const previousPlaces=[...st.place];
  st.place=new Set(previousPlaces.filter(place=>!disabledPlaces.has(place)));
  const placeChanged=st.place.size!==previousPlaces.length;
  updateSourceHealthBadge();
  const dialog=document.getElementById('eventDialog');if(dialog.open)closeDialog(dialog);
  lastMapKey='';
  document.getElementById('total').textContent=akceLabel(EVENTS.filter(sourceAllowed).length);
  if(placeChanged)canonicalize();
  render();
}
function syncFavorites(){favoriteSaveFailed=false;favoriteKeys=MostkulturaFavorites.read();render();refreshStarButtons()}
function refreshFavoriteTime(){
  if(st.tab!=='favorites'||document.getElementById('dateDialog').open)return;
  const keys=MostkulturaFavorites.selected(D.events,favoriteKeys,Date.now(),TZ).map(MostkulturaFavorites.key);
  const buttons=[...document.querySelectorAll('#list [data-favorite-key]')],shown=buttons.map(button=>button.dataset.favoriteKey);
  if(favoritesDayStamp===fmtDate(new Date())&&keys.length===shown.length&&keys.every((key,index)=>key===shown[index]))return;
  const active=document.activeElement,index=buttons.indexOf(active),activeKey=index>=0?active.dataset.favoriteKey:null;
  render();
  if(index<0)return;
  const remaining=[...document.querySelectorAll('#list [data-favorite-key]')];
  const target=remaining.find(button=>button.dataset.favoriteKey===activeKey)||remaining[Math.min(index,remaining.length-1)]||document.querySelector(`${embed?'#periodDesktop':'#tabbar'} [data-tab="favorites"]`);
  target?.focus({preventScroll:true});
}
window.addEventListener('storage',e=>{if(e.key===MostkulturaSources.KEY||e.key===null)syncSourcePreferences();if(e.key===MostkulturaFavorites.KEY||e.key===null)syncFavorites()});
window.addEventListener('pageshow',()=>{syncSourcePreferences();if(!favoriteSaveFailed)syncFavorites();else refreshFavoriteTime()});
document.addEventListener('visibilitychange',()=>{if(!document.hidden)refreshFavoriteTime()});
setInterval(()=>{if(!document.hidden)refreshFavoriteTime()},60000);
window.addEventListener('resize',()=>{if(st.view==='map'&&map){sizeMap();map.invalidateSize()}});
parseState();canonicalize();render();
})();
