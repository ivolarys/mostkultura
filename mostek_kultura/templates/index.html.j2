<script>
(function(){
'use strict';
const D=JSON.parse(document.getElementById('data').textContent);
let sourcePrefs=MostkulturaSources.read();
let sourceAllowed=MostkulturaSources.compile(sourcePrefs);
function updateSourceHealthBadge(){
  const summary=MostkulturaSources.summarizeSources(D.source_catalog,sourcePrefs);
  const health=`${summary.healthy} z ${summary.selected} vybraných zdrojů v pořádku`;
  const issues=summary.issues ? `. Problémové zdroje: ${summary.issueLabels.join(', ')}` : '';
  const label=`Vybrat zdroje, města a místa. Vybrané zdroje: ${summary.selected} z ${summary.available} dostupných. Stav vybraných zdrojů: ${health}${issues}`;
  const link=document.getElementById('sourcesBtn'),badge=document.getElementById('sourceHealthBadge');
  link.setAttribute('aria-label',label);link.title=label;
  badge.textContent=`${summary.selected}/${summary.available}`;
  badge.classList.toggle('source-health-badge--warning',summary.issues>0);
  badge.hidden=false;
}
const TZ=D.tz||'Europe/Prague';
const qs=new URLSearchParams(location.search);
const embed=qs.get('embed')==='1'||new URLSearchParams(location.hash.slice(1)).has('embed');
if(embed)document.body.classList.add('embed');
const svg=body=>`<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
const ICON={
  search:svg('<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>'),
  close:svg('<path d="m6 6 12 12M18 6 6 18"/>'),
  pin:svg('<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.3"/>'),
  list:svg('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>'),
  map:svg('<path d="m3 6 5-3 8 3 5-3v15l-5 3-8-3-5 3V6Z"/><path d="M8 3v15M16 6v15"/>'),
  chev:svg('<path d="m9 5 7 7-7 7"/>').replace('class="icon"','class="icon chev"'),
  source:svg('<path d="M4 4h16l-6 7v7l-4 2v-9L4 4Z"/>'),
  today:svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 9h18"/><circle cx="12" cy="15" r="1.6" fill="currentColor" stroke="none"/>'),
  tomorrow:svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 9h18M9 15h6m0 0-2-2m2 2-2 2"/>'),
  weekend:svg('<circle cx="12" cy="12" r="4.5"/><path d="M12 2.5V5M12 19v2.5M4.2 4.2 6 6M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8 6 18M18 6l1.8-1.8"/>'),
  date:svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 9h18"/><rect x="7" y="12" width="10" height="3" rx="1.5" fill="currentColor" stroke="none"/><path d="M8 18h.01M12 18h.01M16 18h.01"/>'),
  prev:svg('<path d="m15 18-6-6 6-6"/>'),
  next:svg('<path d="m9 18 6-6-6-6"/>'),
  week:svg('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 9h18M8 13h2M12 13h2M16 13h1M8 17h2M12 17h2"/>'),
  all:svg('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>'),
  favorite:svg('<path d="m12 2.8 2.78 5.63 6.22.9-4.5 4.39 1.06 6.2L12 17l-5.56 2.92 1.06-6.2L3 9.33l6.22-.9L12 2.8Z"/>'),
  share:svg('<path d="M12 16V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/>'),
  concert:svg('<path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>'),
  theatre:svg('<path d="M4 5c3 1 5 1 8 0v7c0 4-2 7-4 8-2-1-4-4-4-8V5Z"/><path d="M7 9h.01M10 9h.01M6.5 14c1 .8 2 .8 3 0M13 5c3 1 5 1 7 0v7c0 3-1 5-3 7M15 9h.01M18 9h.01"/>'),
  film:svg('<rect x="3" y="6" width="18" height="14" rx="2"/><path d="m3 10 18-4M7 7l2 3M13 5.5l2 3M8 14l5 3v-6l-5 3Z"/>'),
  art:svg('<rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m5 18 5-5 3 3 2-2 4 4"/>'),
  kids:svg('<circle cx="12" cy="12" r="8"/><path d="M9 10h.01M15 10h.01M9 15c2 1.5 4 1.5 6 0M7 5 5 3M17 5l2-2"/>'),
  market:svg('<path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/>'),
  sport:svg('<circle cx="12" cy="12" r="9"/><path d="m8.5 4.7 1.4 3.7 4.2.1 1.4-3.8M9.9 8.4 7.5 12l1.4 4h6.2l1.4-4-2.4-3.5M8.9 16 6 19M15.1 16l2.9 3M7.5 12l-4.3-.2M16.5 12l4.3-.2"/>'),
  talk:svg('<path d="M4 5h16v12H9l-5 4V5Z"/><path d="M8 9h8M8 13h5"/>'),
  festival:svg('<path d="M12 3v18M7 6l5 2 5-2M6 12l6 2 6-2M8 20h8"/>'),
  community:svg('<path d="M3 20h18M5 20v-8l7-6 7 6v8M9 20v-5h6v5"/>'),
  other:svg('<path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3ZM19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"/>')
};
const CAT_ICON={koncert:'concert',divadlo:'theatre',film:'film',vystava:'art',deti:'kids',trh:'market',sport:'sport',prednaska:'talk',slavnost:'festival',komunita:'community',jine:'other'};
const catIcon=slug=>ICON[CAT_ICON[slug]||'other'];
const dateFormatter=new Intl.DateTimeFormat('sv-SE',{timeZone:TZ});
const timeFormatter=new Intl.DateTimeFormat('cs-CZ',{timeZone:TZ,hour:'2-digit',minute:'2-digit'});
const dayFormatter=new Intl.DateTimeFormat('cs-CZ',{weekday:'long',day:'numeric',month:'long',timeZone:'UTC'});
const fullDateFormatter=new Intl.DateTimeFormat('cs-CZ',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const generatedFormatter=new Intl.DateTimeFormat('cs-CZ',{timeZone:TZ,day:'numeric',month:'numeric',hour:'2-digit',minute:'2-digit'});
const fmtDate=d=>dateFormatter.format(d);
const today=fmtDate(new Date());
const dateRange=MostkulturaDateRange;
const addDays=(iso,n)=>dateRange.addDays(iso,n);
const dow=iso=>(new Date(iso+'T12:00:00Z').getUTCDay()+6)%7;
const weekendStart=addDays(today,4-dow(today));
const TABS=[['today','Dnes',[today,today]],['tomorrow','Zítra',[addDays(today,1),addDays(today,1)]],['weekend','Pá–Ne',[weekendStart,addDays(weekendStart,2)]],['week','Týden',[today,addDays(today,6)]],['all','Vše',[today,'9999-12-31']]];
const BAR_TABS=['today','tomorrow','weekend','date'];
const CAT=Object.fromEntries(D.categories.map(c=>[c.slug,{label:c.label}]));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm=MostkulturaPlaceSearch.normalize;
const collator=new Intl.Collator('cs',{sensitivity:'base'});

D.events.forEach(e=>{e.sd=fmtDate(new Date(e.start));e.ed=e.end?fmtDate(new Date(e.end)):e.sd;e.time=e.all_day?null:timeFormatter.format(new Date(e.start));e.search=norm([e.title,e.place,e.venue].filter(Boolean).join(' '))});
const EVENTS=D.events.filter(e=>!e.ongoing||e.ed>=today);
const VALID={tab:new Set([...TABS.map(t=>t[0]),'date','favorites']),cat:new Set(D.categories.map(c=>c.slug)),group:new Set(['day','category']),view:new Set(['list','map'])};
let favoriteKeys=MostkulturaFavorites.read(),favoriteSaveFailed=false;
const eventPlaces=new Set(EVENTS.map(e=>e.place||'?'));
const validPlaces=new Set([...D.places,...eventPlaces]);
const LEGACY_PLACE_MAP={'Valdštejnská lodžie':'Jičín'};
const st={tab:'today',date:today,dateEnd:today,cat:new Set(),place:new Set(),group:'category',view:'list',q:''};
const disabledPlaceSet=()=>new Set(sourcePrefs.disabledPlaces);
const validISODate=dateRange.validISODate;

function parseState(){
  const h=new URLSearchParams(location.hash.replace(/^#/,''));
  st.tab=VALID.tab.has(h.get('tab'))?h.get('tab'):(VALID.tab.has(qs.get('tab'))?qs.get('tab'):'today');
  const hasHashDate=h.has('date'),rawDate=hasHashDate?h.get('date'):qs.get('date'),rawDateEnd=hasHashDate?h.get('end'):qs.get('end');
  [st.date,st.dateEnd]=dateRange.normalizeRange(rawDate,rawDateEnd,today);
  if(st.tab==='date'&&!validISODate(rawDate))st.tab='today';
  st.group=VALID.group.has(h.get('group'))?h.get('group'):(VALID.group.has(qs.get('group'))?qs.get('group'):'category');
  st.view=VALID.view.has(h.get('view'))?h.get('view'):(VALID.view.has(qs.get('view'))?qs.get('view'):'list');
  st.cat=new Set((h.get('cat')||'').split(',').filter(x=>VALID.cat.has(x)));
  const disabledPlaces=disabledPlaceSet();
  st.place=new Set((h.get('place')||'').split(',').map(x=>LEGACY_PLACE_MAP[x]||x).filter(x=>validPlaces.has(x)&&!disabledPlaces.has(x)));
  st.q=(h.get('q')||'').trim().slice(0,120);
}
function stateHash(){
  const h=new URLSearchParams();h.set('tab',st.tab);h.set('group',st.group);h.set('view',st.view);
