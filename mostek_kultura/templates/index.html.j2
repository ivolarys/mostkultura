  document.getElementById('list').innerHTML=html;
}
let favoritesDayStamp='';
function renderFavorites(events){
  const list=document.getElementById('list');
  favoritesDayStamp=fmtDate(new Date());
  if(!events.length){list.innerHTML=`<div class="empty">${ICON.favorite}<div class="empty-title">Zatím žádné nadcházející oblíbené akce</div><div class="empty-sub">Akci si uložíte klepnutím na hvězdičku.</div></div>`;return}
  const nowDay=favoritesDayStamp;
  const favoriteDayLabel=day=>{const label=dayFormatter.format(new Date(day+'T12:00:00Z'));return day===nowDay?'Dnes · '+label:day===addDays(nowDay,1)?'Zítra · '+label:label};
  const groups=new Map();
  events.forEach(e=>{const day=e.sd<nowDay?nowDay:e.sd;if(!groups.has(day))groups.set(day,[]);groups.get(day).push(e)});
  list.innerHTML=[...groups].sort(([a],[b])=>a.localeCompare(b)).map(([day,items])=>`<section aria-labelledby="favorite-${esc(day)}"><h2 class="grp grp-title" id="favorite-${esc(day)}">${ICON.today}<span>${esc(favoriteDayLabel(day))}</span></h2><div class="list-card">${items.map(e=>eventHtml(e,false)).join('')}</div></section>`).join('');
