function update(mutator,replace,focusSelector){pendingFocus=focusSelector??focusKey(document.activeElement);mutator();const hash=stateHash();if(location.hash.slice(1)===hash){render();return}if(replace)history.replaceState(null,'','#'+hash),render();else location.hash=hash}

function rangeFor(tab=st.tab){return tab==='date'?[st.date,st.dateEnd]:tab==='favorites'?[today,'9999-12-31']:TABS.find(t=>t[0]===tab)[2]}
function relevant(e,range=rangeFor()){return e.ongoing?(e.sd<=range[1]&&e.ed>=range[0]):(e.sd>=range[0]&&e.sd<=range[1])}
function matches(e,places=st.place,query=norm(st.q)){return sourceAllowed(e)&&(!st.cat.size||st.cat.has(e.category))&&(!places.size||places.has(e.place||'?'))&&(!query||e.search.includes(query))}
function visibleEvents(places=st.place,query=norm(st.q)){
  const range=rangeFor(),main=[],ongoing=[];
  EVENTS.forEach(e=>{
    if(!relevant(e,range)||!matches(e,places,query))return;
    (e.ongoing&&e.sd<range[0]?ongoing:main).push(e);
  });
  return {main,ongoing};
}
const akceLabel=n=>n===1?n+' akce':n>=2&&n<=4?n+' akce':n+' akcí';
const dniLabel=n=>n===1?'den':n>=2&&n<=4?'dny':'dní';
const shortDate=iso=>{const [y,m,d]=iso.split('-');return `${Number(d)}. ${Number(m)}.`};
const compactDateRange=(start,end)=>{if(start===end)return fullDateFormatter.format(new Date(start+'T12:00:00Z'));const sy=start.slice(0,4),ey=end.slice(0,4);return sy===ey?`${shortDate(start)}–${shortDate(end)} ${sy}`:`${shortDate(start)} ${sy}–${shortDate(end)} ${ey}`};
const dayLabel=iso=>{const d=new Date(iso+'T12:00:00Z');const s=dayFormatter.format(d);return iso===today?'Dnes · '+s:iso===addDays(today,1)?'Zítra · '+s:s};
function rangeLabel(){const t=TABS.find(x=>x[0]===st.tab);if(st.tab==='favorites')return 'Oblíbené';if(st.tab==='date')return compactDateRange(st.date,st.dateEnd);if(st.tab==='all')return 'Od dneška dál';if(st.tab==='today'||st.tab==='tomorrow')return `${t[1]} · ${shortDate(t[2][0])}`;if(t[2][0]===t[2][1])return dayLabel(t[2][0]);return `${shortDate(t[2][0])}–${shortDate(t[2][1])}`}

function eventHtml(e,showDate,dayStart=false,showCategory=true){
  const current=e.ongoing&&e.sd<(st.tab==='favorites'?fmtDate(new Date()):today);
  const when=current
    ? `<span>Probíhá do</span><span>${esc(shortDate(e.ed))}</span>`
    : `${e.ongoing||showDate?`<span>${esc(e.ongoing?`${shortDate(e.sd)}–${shortDate(e.ed)}`:shortDate(e.sd))}</span>`:''}<span>${e.ongoing||showDate?'· ':''}${e.time?esc(e.time):'Celý den'}</span>`;
  const img=embed?'':e.image?`<img class="thumb" src="${esc(e.image)}" alt="" loading="lazy">`:`<span class="thumb thumb-placeholder" aria-hidden="true">${catIcon(e.category)}</span>`;
  const where=[e.place,e.venue&&e.venue!==e.place?e.venue:null].filter(Boolean).join(' · ');
  const category=showCategory?`<span class="pill c-${esc(e.category)}">${esc((CAT[e.category]||{}).label||e.category)}</span>`:'';
  const source=(e.source_labels||e.sources||[]).join(', ');
  const context=category||source?`<div class="event-context${category?'':' source-only'}">${category}${source?`<span class="srcline">${esc(source)}</span>`:''}</div>`:'';
  const inner=`${img}<div class="content"><div class="title">${esc(e.title)}</div><div class="meta"><span class="where">${ICON.pin}<span class="where-text">${esc(where||'Místo neuvedeno')}</span></span>${context}</div></div>`;
  const cls=`row event-row c-${esc(e.category)}${dayStart?' category-day-start':''}`;
  const key=MostkulturaFavorites.key(e),saved=MostkulturaFavorites.has(favoriteKeys,e);
  const action=`${saved?'Odebrat':'Přidat'} ${e.title} ${saved?'z':'do'} oblíbených`;
  const star=`<button type="button" class="favorite-btn" data-favorite-key="${esc(key)}" aria-pressed="${saved}" aria-label="${esc(action)}" title="${esc(action)}">${ICON.favorite}</button>`;
  const shareAction=`Sdílet ${e.title}`;
  const share=`<button type="button" class="share-btn" data-share-key="${esc(key)}" aria-label="${esc(shareAction)}" title="${esc(shareAction)}">${ICON.share}</button>`;
  const link=e.url?`<a class="event-link" href="${esc(e.url)}" target="_blank" rel="noopener">${inner}</a>`:`<div class="event-link">${inner}</div>`;
  return `<div class="${cls}">${link}<div class="event-footer"><div class="event-when">${when}</div><div class="event-actions">${star}${share}</div></div></div>`;
}
function computeRenderSnapshot(){
  const query=norm(st.q),range=rangeFor(),tabCounts=Object.fromEntries([...TABS.map(t=>[t[0],0]),['date',0]]);
  const categoryCounts={},visible={main:[],ongoing:[]};
  let categoryTotal=0;
  EVENTS.forEach(e=>{
    const selected=matches(e,st.place,query);
    if(selected){
      TABS.forEach(t=>{if(relevant(e,t[2]))tabCounts[t[0]]++});
      if(relevant(e,[st.date,st.dateEnd]))tabCounts.date++;
    }
    if(!relevant(e,range))return;
    if(sourceAllowed(e)&&(!st.place.size||st.place.has(e.place||'?'))&&(!query||e.search.includes(query))){
      categoryTotal++;
      categoryCounts[e.category]=(categoryCounts[e.category]||0)+1;
    }
    if(selected){
      (e.ongoing&&e.sd<range[0]?visible.ongoing:visible.main).push(e);
    }
  });
  return {categoryCounts,categoryTotal,tabCounts,visible};
}

