      const regular=groups[k].main.sort((a,b)=>a.start.localeCompare(b.start));
      const live=groups[k].ongoing.sort((a,b)=>a.ed.localeCompare(b.ed)||a.start.localeCompare(b.start));
      const multiDay=rangeFor()[0]!==rangeFor()[1];
      const ordinaryHtml=regular.length
        ? `<div class="list-card">${regular.map((e,i)=>eventHtml(e,true,multiDay&&i>0&&e.sd!==regular[i-1].sd,false)).join('')}</div>`
        : '';
      const ongoingHtml=live.length
        ? `<div class="category-ongoing"><h3 class="category-ongoing-title"><span>Několikadenní akce, které právě probíhají</span></h3><div class="list-card">${live.map(e=>eventHtml(e,true,false,false)).join('')}</div></div>`
        : '';
      return `<section aria-labelledby="grp-${esc(k)}"><h2 class="grp grp-title c-${esc(k)}" id="grp-${esc(k)}">${catIcon(k)}<span>${esc(label)}</span></h2>${ordinaryHtml}${ongoingHtml}</section>`;
    }).join('');
    if(!keys.length)html=emptyState(place);
    document.getElementById('list').innerHTML=html;return;
  }
