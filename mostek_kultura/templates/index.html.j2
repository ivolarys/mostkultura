:root[data-theme="dark"] .leaflet-control-attribution{background:rgba(33,24,41,.84)!important;color:#d5cdd8!important}

dialog{color:var(--label)}
.sheet{width:100%;max-width:640px;max-height:min(82vh,760px);margin:auto auto 0;padding:0;border:0;border-radius:22px 22px 0 0;background:var(--elevated);box-shadow:0 -12px 50px rgba(0,0,0,.24);overflow:hidden}
.sheet::backdrop{background:rgba(20,12,22,.46);-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
.sheet-layout{position:relative;max-height:min(82vh,760px);display:flex;flex-direction:column}
