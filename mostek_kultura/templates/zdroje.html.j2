<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png?v=mostkultura-1">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Zdroje podle obce · Mostkultura</title>
<link rel="icon" href="icon.svg?v=mostkultura-1" type="image/svg+xml">
<style>
{% include "_base.css.j2" %}
/* ==== layout ==== */
.wrap{max-width:900px;margin:0 auto;padding:0 var(--page-gutter) 32px}
.navbar{display:flex;align-items:center;min-height:56px;padding:0 12px;position:sticky;top:var(--safe-top);z-index:10;background:rgba(251,247,241,.92);-webkit-backdrop-filter:saturate(170%) blur(18px);backdrop-filter:saturate(170%) blur(18px);border-bottom:1px solid var(--sep);margin:0 calc(-1 * var(--page-gutter))}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .navbar{background:rgba(22,16,29,.91)}}
:root[data-theme="dark"] .navbar{background:rgba(22,16,29,.91)}
.navbar .back{color:var(--tint);font-size:var(--text-body);font-weight:var(--weight-control);flex:0 0 auto;min-height:44px;display:flex;align-items:center;gap:4px;padding:0 8px;border-radius:var(--radius-control)}
.navbar .back:hover{background:var(--active)}
.navbar .back .icon{width:19px;height:19px}
.navbar h1{font-size:var(--text-title);font-weight:var(--weight-emphasis);margin:0;flex:1;text-align:center;padding-right:76px}
.page-head{padding:24px 0 8px}
.eyebrow{display:flex;align-items:center;gap:7px;color:var(--label);font-size:16px;text-transform:none;letter-spacing:0;font-weight:800}
.eyebrow-logo{width:24px;height:22px;display:block;object-fit:contain}
.eyebrow .icon{width:19px;height:19px}
.page-head h2{font-size:24px;font-weight:var(--weight-emphasis);line-height:1.15;letter-spacing:-.02em;margin:12px 0 8px}
.sub{font-size:12px;color:var(--label3);margin:0}
.page-head>.sub{margin-bottom:8px}
.intro{color:var(--label2);font-size:var(--text-body);max-width:680px;margin:0 0 8px}
.src-row{align-items:flex-start}
.src-row .subline{display:flex;gap:4px;flex-wrap:wrap}
.src-icon{width:36px;height:36px;flex:0 0 36px;border-radius:var(--radius-thumb);background:var(--fill);color:var(--label2);display:flex;align-items:center;justify-content:center;margin-top:0}
.src-icon .icon{width:19px;height:19px}
.src-row .meta{flex-wrap:wrap;white-space:normal;overflow-wrap:anywhere}
.src-row .title a:hover{color:var(--tint)}
.source-group-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.source-group-head.grp{margin-bottom:8px}.source-group-head h2{margin:0;font-size:var(--text-title);line-height:1.25;font-weight:var(--weight-emphasis);letter-spacing:0;text-transform:none}.source-group-head h2 .n{font-size:var(--text-secondary)}.source-group-head h2 .aliases{font-size:var(--text-secondary);font-weight:var(--weight-regular);line-height:1.4;margin-top:4px}
.source-toggle{position:relative;display:inline-flex;align-items:center;justify-content:center;flex:0 0 44px;min-width:44px;min-height:44px;cursor:pointer}
.source-toggle input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;z-index:1;cursor:pointer}
.source-toggle input:disabled{cursor:not-allowed}.source-toggle-ui{width:38px;height:24px;border-radius:999px;background:var(--label3);position:relative;z-index:0;pointer-events:none;transition:background .16s ease}
.source-toggle-ui::after{content:"";position:absolute;width:18px;height:18px;top:3px;left:3px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.25);transition:transform .16s ease}
.source-toggle input:checked + .source-toggle-ui{background:var(--ok)}
.source-toggle input:checked + .source-toggle-ui::after{transform:translateX(14px)}
.source-toggle input:focus-visible + .source-toggle-ui{outline:3px solid var(--focus);outline-offset:3px}
.source-toggle input:disabled + .source-toggle-ui{opacity:1;background:var(--label3)}
.source-toggle input:disabled:checked + .source-toggle-ui::after{transform:none}
.source-settings{margin:12px 0 16px;padding:12px;color:var(--label2);font-size:var(--text-body);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:var(--active);border:1px solid var(--sep);border-radius:var(--radius-control)}
.source-settings span{font-weight:var(--weight-control);line-height:1.4;flex:1 1 220px}
.source-reset{min-height:44px;padding:0 12px;color:var(--tint);font-weight:var(--weight-control);background:var(--card);border:1px solid var(--sep);border-radius:var(--radius-control);white-space:nowrap}
.source-reset:hover{background:var(--active)}
.storage-warning{margin:8px 0 0;color:var(--warn);font-size:var(--text-meta)}
.source-group{margin-bottom:20px}
.source-group.is-disabled>.source-group-head,.source-group.is-disabled>.list-card,.source-group.is-disabled .row,.src-row.is-disabled{background:var(--fill)}
.source-group-head.is-disabled{border-radius:12px}
.source-status-badge{display:inline-flex;align-items:center;min-height:22px;padding:1px 8px;border-radius:999px;background:var(--card);border:1px solid var(--sep);color:var(--label2);font-size:var(--text-caption);font-weight:var(--weight-control);letter-spacing:.01em;white-space:nowrap}
.source-group-head h2 .source-status-badge{margin-left:7px;vertical-align:middle}
.src-row.is-disabled .subline{color:var(--label2)}
@media (min-width:700px){.page-head h2{font-size:28px}.grp .aliases{display:inline;margin-left:8px}}
</style>
</head>
<body>
<div class="wrap">
<nav class="navbar"><a class="back" id="backLink" href="./"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>Přehled</a><h1>Zdroje</h1></nav>
<header class="page-head">
  <div class="eyebrow"><img class="eyebrow-logo" src="logo.svg?v=mostkultura-1" alt="">Mostkultura</div>
  <h2>Odkud akce bereme</h2>
  <p class="sub">Aktualizováno {{ generated_at[:16].replace('T',' ') }}</p>
  <p class="intro">U každé obce vidíte pokryté weby, výsledek posledního stažení a počet aktuálních akcí. Volby se ukládají jen v tomto prohlížeči. Vypnutí obce skryje i regionální akce v ní a zachová stav jejích zdrojů; akce z více zdrojů zůstane vidět, když je zapnutý alespoň jeden.</p>
  <div class="source-settings"><span id="sourceSettingsNote">Vyberte, které zdroje chcete v přehledu vidět.</span><button class="source-reset" id="sourceReset" type="button" hidden>Zapnout vše</button></div>
  <p class="storage-warning" id="storageWarning" role="status" hidden>Nastavení se nepodařilo uložit. Pro zapamatování voleb povolte ukládání dat pro tento web.</p>
</header>

{% for g in groups %}
<div class="source-group" data-place-group="{{ g.place }}"><div class="source-group-head grp"><h2>{{ g.place }}<span class="n"> · {{ g.event_count|akce }} v přehledu</span><span class="source-status-badge" data-place-status hidden>Vypnuto</span>{% if g.aliases %}<span class="aliases">také: {{ g.aliases|join(', ') }}</span>{% endif %}</h2><label class="source-toggle" title="Zapnout nebo vypnout obec {{ g.place }}"><input type="checkbox" data-place="{{ g.place }}" aria-label="Zobrazovat obec {{ g.place }}"><span class="source-toggle-ui" aria-hidden="true"></span></label></div>
<div class="list-card">
{% for s in g.sources %}
<div class="row src-row" data-source-row="{{ s.name }}" data-source-place="{{ g.place }}">
  <span class="src-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></svg></span>
  <div class="content">
    <div class="title"><a href="{{ s.page }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
    <div class="meta">{{ s.host }}{% if s.covers %} · pokrývá: {{ s.covers|join(', ') }}{% endif %}</div>
    <div class="subline">{{ s.count|akce }} · {{ s.fetched }} · {{ s.status_label }} <span class="source-status-badge" data-source-status hidden></span></div>
  </div>
  <label class="source-toggle" title="Zapnout nebo vypnout zdroj {{ s.title }}"><input type="checkbox" data-source="{{ s.name }}" data-source-place="{{ g.place }}" aria-label="Zobrazovat zdroj {{ s.title }}"><span class="source-toggle-ui" aria-hidden="true"></span></label>
</div>
{% else %}
<div class="row none-row">Zatím bez vlastního zdroje – akce jen z regionálních zdrojů níže.</div>
{% endfor %}
</div>
</div>
{% endfor %}

<h2 class="grp">Regionální zdroje<span class="n"> · více obcí</span></h2>
<div class="list-card">
{% for s in regional %}
<div class="row src-row" data-source-row="{{ s.name }}">
  <span class="src-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></svg></span>
  <div class="content">
    <div class="title"><a href="{{ s.page }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
    <div class="meta">{{ s.host }}{% if s.covers %} · pokrývá: {{ s.covers|join(', ') }}{% endif %}</div>
    <div class="subline">{{ s.count|akce }} · {{ s.fetched }} · {{ s.status_label }} <span class="source-status-badge" data-source-status hidden></span></div>
  </div>
  <label class="source-toggle" title="Zapnout nebo vypnout zdroj {{ s.title }}"><input type="checkbox" data-source="{{ s.name }}" aria-label="Zobrazovat zdroj {{ s.title }}"><span class="source-toggle-ui" aria-hidden="true"></span></label>
</div>
{% endfor %}
</div>

{% if venues_allow %}
<h2 class="grp">Konkrétní místa mimo seznam obcí</h2>
<div class="list-card"><div class="row none-row">Vždy zobrazená venue: {{ venues_allow|join(', ') }}</div></div>
{% endif %}

</div>
<script src="source-preferences.js?v=mostkultura-4"></script>
<script>
(() => {
  'use strict';
  let prefs = MostkulturaSources.read(), storageWarning = false, storageUnavailable = false;
  const controls = [...document.querySelectorAll('input[data-source], input[data-place]')];
  const sourceRows = [...document.querySelectorAll('[data-source-row]')];
  const render = () => {
    controls.forEach(input => {
      const key = input.dataset.source || input.dataset.place;
      const personalSourceEnabled = input.dataset.source ? !prefs.disabledSources.includes(key) : null;
      input.checked = input.dataset.source ? personalSourceEnabled : !prefs.disabledPlaces.includes(key);
      const placeDisabled = !!(input.dataset.source && input.dataset.sourcePlace && prefs.disabledPlaces.includes(input.dataset.sourcePlace));
      input.disabled = placeDisabled;
      input.closest('.source-toggle').setAttribute('aria-disabled', String(placeDisabled));
      if (input.dataset.source) {
        const row = sourceRows.find(candidate => candidate.dataset.sourceRow === key);
        if (!row) return;
        const disabled = !personalSourceEnabled || placeDisabled;
        row.classList.toggle('is-disabled', disabled);
        const badge = row.querySelector('[data-source-status]');
        badge.hidden = !disabled;
        badge.textContent = !personalSourceEnabled ? 'Vypnuto' : 'Vypnuto městem';
        const badgeId = `source-status-${sourceRows.indexOf(row)}`;
        badge.id = badgeId;
        if (disabled) input.setAttribute('aria-describedby', badgeId);
        else input.removeAttribute('aria-describedby');
      }
    });
    document.querySelectorAll('[data-place-group]').forEach(group => {
      const disabled = prefs.disabledPlaces.includes(group.dataset.placeGroup);
      group.classList.toggle('is-disabled', disabled);
      group.querySelector('.source-group-head').classList.toggle('is-disabled', disabled);
      group.querySelector('[data-place-status]').hidden = !disabled;
    });
    const excluded = prefs.disabledSources.length + prefs.disabledPlaces.length;
    document.getElementById('sourceReset').hidden = !excluded;
    document.getElementById('sourceSettingsNote').textContent = excluded ? `Vypnutá města: ${prefs.disabledPlaces.length} · zdroje: ${prefs.disabledSources.length}` : 'Vyberte, které zdroje chcete v přehledu vidět.';
    document.getElementById('storageWarning').hidden = !storageWarning;
  };
  const save = () => { storageWarning = !MostkulturaSources.save(prefs); storageUnavailable = storageWarning; render(); };
  document.addEventListener('change', event => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement)) return;
    const list = input.dataset.source ? 'disabledSources' : input.dataset.place ? 'disabledPlaces' : null;
    if (!list) return;
    const key = input.dataset.source || input.dataset.place;
    const values = new Set(prefs[list]);
    if (input.checked) values.delete(key); else values.add(key);
    prefs = MostkulturaSources.normalize({...prefs, [list]: [...values]});
    save();
  });
  document.getElementById('sourceReset').addEventListener('click', () => { prefs = MostkulturaSources.normalize({}); save(); });
  try {
    const hash = sessionStorage.getItem('mostkultura.sourceReturnHash');
    if (typeof hash === 'string' && hash.startsWith('#')) document.getElementById('backLink').href = `./${hash}`;
  } catch (_) {}
  const reload = () => { if (!storageUnavailable) prefs = MostkulturaSources.read(); render(); };
  window.addEventListener('storage', event => { if (event.key === MostkulturaSources.KEY || event.key === null) reload(); });
  window.addEventListener('pageshow', reload);
  render();
})();
</script>
</body>
</html>
